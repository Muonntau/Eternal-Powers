{
  "name": "eternal-powers",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test src/game/*.test.js src/reborn/*.test.js",
    "test:browser": "playwright test",
    "format": "prettier --write src tests *.js",
    "server": "node server/index.js",
    "start": "node server/index.js",
    "test:network": "node --test tests/network*.test.js",
    "prebuild": "node scripts/build-offline-index.mjs",
    "postbuild": "node scripts/build-offline-index.mjs --dist",
    "test:offline": "node --test tests/offline.test.js",
    "check": "npm test && npm run test:network && npm run test:offline && npm run build"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.0",
    "@fontsource/inter": "^5.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "prettier": "^3.10.1",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
